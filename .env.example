# Токен от @BotFather. Никому не показывай, при утечке делай /revoke в @BotFather
BOT_TOKEN=
# Ключ Anthropic API (необязательно). Без него бот делает разбор только по цифрам.
ANTHROPIC_API_KEY=
# Модель для ИИ-разбора: claude-haiku-5-5 (дешевле) или claude-sonnet-5-5 (умнее)
CLAUDE_MODEL=claude-haiku-5-5
# Сколько ИИ-разборов в день доступно одному пользователю
AI_DAILY_LIMIT=10
# Файл базы данных
DB_PATH=bot.db
# Адрес веб-приложения (GitHub Pages из папки docs), например https://bezzz22.github.io/KORPl
WEBAPP_URL=
