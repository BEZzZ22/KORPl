# Токен от @BotFather. Никому не показывай, при утечке делай /revoke в @BotFather
BOT_TOKEN=
# ИИ-тренер (необязательно). Без ключа бот делает разбор только по цифрам.
# Провайдер: gemini или anthropic. Если не задан, берётся тот, чей ключ указан ниже.
AI_PROVIDER=
# Ключ Gemini из aistudio.google.com (есть бесплатный тариф)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Ключ Anthropic: claude-haiku-5-5 (дешевле) или claude-sonnet-5-5 (умнее)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Сколько ИИ-разборов в день доступно одному пользователю
AI_DAILY_LIMIT=10
# Файл базы данных
DB_PATH=bot.db
# Адрес веб-приложения (GitHub Pages из папки docs), например https://bezzz22.github.io/KORPl
WEBAPP_URL=
# Ники через запятую, которым бот вместо разбора отвечает BLOCKED_MESSAGE
BLOCKED_USERNAMES=
BLOCKED_MESSAGE=Тебе сюда нельзя.
